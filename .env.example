# Copy to .env and fill in. NEVER commit .env.
# Get paper keys at https://app.alpaca.markets (Paper account -> API Keys)
ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here
ALPACA_PAPER=true

# For the LLM research layer (`python main.py research`). A free Gemini key works.
GEMINI_API_KEY=

# Alerts on your phone (optional). Without these, alerts still show as Windows
# notifications, in the dashboard and in logs/alerts.log.
# ntfy: install the free "ntfy" app, subscribe to a topic name you make up, and
# put the same name here. Anyone who knows the name can read the messages, so
# make it long and random, e.g. trading-7f3k9q2x8m.
NTFY_TOPIC=
# Or a Discord channel webhook (Channel settings -> Integrations -> Webhooks).
DISCORD_WEBHOOK_URL=
