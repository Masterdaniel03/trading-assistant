# Copy to .env and fill in. NEVER commit .env.
# Get paper keys at https://app.alpaca.markets (Paper account -> API Keys)
ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here
ALPACA_PAPER=true

# For the LLM research layer (`python main.py research`). A free Gemini key works.
GEMINI_API_KEY=
